function(modern_sqlite_label_shared_verification_tests)
  set(policy_path "${PROJECT_SOURCE_DIR}/project/verification-policy.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${policy_path}")
  file(READ "${policy_path}" policy)
  string(JSON schema_version GET "${policy}" schema_version)
  if(NOT schema_version EQUAL 1)
    message(FATAL_ERROR "Unsupported verification policy schema")
  endif()
  string(JSON label GET "${policy}" shared_test_label)
  string(JSON test_count LENGTH "${policy}" configuration_independent_tests)
  if(test_count LESS 1)
    message(FATAL_ERROR "Shared verification selection must not be empty")
  endif()
  math(EXPR last_test "${test_count} - 1")
  foreach(index RANGE 0 ${last_test})
    string(JSON test_name GET "${policy}" configuration_independent_tests ${index})
    if(TEST "${test_name}")
      set_property(TEST "${test_name}" APPEND PROPERTY LABELS "${label}")
    endif()
  endforeach()
endfunction()
